[
 {
  "line_id": "41cc2ba1-741c-4a7f-a46d-c8c82c24e3fe",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 0,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": null,
  "line_html": "새벽 다섯 시가 조금 넘은 바닷가. 안개가 해안 길 위로 낮게 깔려 있고, 멀리서 썰물이 자갈을 끌어내리는 소리가 들린다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:06",
  "updated_at": "2026-10-07 23:37:06"
 },
 {
  "line_id": "4a8744e6-28f1-4d7a-afd5-20eaedaed1a9",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 1,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": null,
  "line_html": "길이 끝나는 곳에 작은 선착장이 있다. 그물을 말리는 대, 뒤집어 놓은 나룻배 한 척, 기름 냄새. 그 옆 갓길에 렌터카 한 대가 시동을 끈 채 서 있다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:06",
  "updated_at": "2026-10-07 23:37:06"
 },
 {
  "line_id": "aff1f007-abe9-40fc-a50c-bd6a93c69a4b",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 2,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": null,
  "line_html": "마커스가 운전석에서 내려 코트 깃을 세운다. 공항에서 밤새 달려온 길이다. 보닛 위에 서류철을 펼쳐 놓고 안개 너머를 한참 바라보는 사이, 조수석 문이 닫히는 소리가 들린다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:06",
  "updated_at": "2026-10-07 23:37:06"
 },
 {
  "line_id": "6684ba59-5cbe-41b0-83bf-f926f7d43361",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 3,
  "speaker_type": "PLAYER",
  "role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
  "line_html": "내비게이션이 여기가 끝이라네요. 이 시간에 닿을 줄은 몰랐는데.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:06",
  "updated_at": "2026-10-07 23:37:06"
 },
 {
  "line_id": "5dfc8232-c81e-4910-b0dd-86f0330b41d0",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 4,
  "speaker_type": "PLAYER",
  "role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
  "line_html": "(돌아보며) 공항에서 생각보다 멀었습니다. 한숨도 못 주무셨을 텐데, 괜찮으십니까?",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:06",
  "updated_at": "2026-10-07 23:37:06"
 },
 {
  "line_id": "e1ffc27c-9f8f-4527-9149-5d8541a67046",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 5,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": null,
  "line_html": "베일라는 외투 소매에 맺힌 안개를 털며 웃는다. 일 년 사이 눈 밑이 조금 어두워졌지만 걸음은 여전히 가볍다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "31173d72-066f-4523-806c-4f77990b0afc",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 6,
  "speaker_type": "PLAYER",
  "role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
  "line_html": "제가 기억하던 것보다 더 외진 곳이네요.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "40bc6915-8e53-4c92-a382-5ab9cfb0005f",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 7,
  "speaker_type": "PLAYER",
  "role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
  "line_html": "고향이시라고 했죠. 오랜만에 와 보시니 어떻습니까?",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "9a6e2c95-7a25-41e4-aafe-041a48b032d7",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 8,
  "speaker_type": "PLAYER",
  "role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
  "line_html": "어릴 때는 이 길이 세상 끝처럼 보였는데, 지금 보니 그냥 길이네요.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "f5f64a92-0f4f-4235-96d9-a810220cfc87",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 9,
  "speaker_type": "PLAYER",
  "role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
  "line_html": "시설은 이 해안 길로 조금만 가면 있습니다. 같이 가서 먼저 확인하죠.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "39132f77-38be-496b-8cb9-2f59ace839ad",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 10,
  "speaker_type": "PLAYER",
  "role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
  "line_html": "시설부터요? 저는 섬 쪽을 먼저 보고 싶은데요. 크래비스라면 어릴 때 몇 번 가 본 적이 있어요.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "1d47c01b-0234-46ba-85eb-f6da9f5a19b7",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 11,
  "speaker_type": "PLAYER",
  "role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
  "line_html": "섬마을은 시설 조사가 끝난 뒤에 보면 됩니다. 정식으로 배정받은 건 시설이니까요.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "94f1eed5-3bdd-453b-aa7b-ad4a496d42f5",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 12,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": null,
  "line_html": "마커스가 서류철에서 지도 한 장을 꺼낸다. 렌터카 업체에서 받은 해안 안내 지도다. 해안선과 섬, 그 사이를 잇는 점선 하나가 인쇄되어 있다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "86ad7379-444f-4d7e-8036-7de27b758d72",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 13,
  "speaker_type": "PLAYER",
  "role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
  "line_html": "섬 쪽은 점선 하나가 전부군요. 바닷길이 언제 닫히는지도 적혀 있지 않습니다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-13 17:25:18"
 },
 {
  "line_id": "d41f4e0a-8ea4-4ab1-b9c4-ac7578a20895",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 14,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": null,
  "line_html": "선착장 끝에서 그물을 손질하던 노인이 고개를 든다. 햇볕에 그을린 얼굴에 주름이 깊고 손마디가 굵다. 두 사람이 지도를 펼쳐 놓고 서 있는 것을 한참 지켜본 눈치다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "496369a5-2167-409a-9e7c-339899f7164a",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 15,
  "speaker_type": "PLAYER",
  "role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
  "line_html": "(다가가며) 실례합니다. 저 바닷길을 건너려는데, 조심할 게 있습니까?",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "ee1c0b99-6d27-4cfb-943d-a0115a96bd9b",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 16,
  "speaker_type": "NPC",
  "role_id": null,
  "npc_id": "23b07013-b397-4346-b4cd-97a901836ed5",
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-fisherman\">어부</span>",
  "line_html": "저 길은 평소엔 물에 잠겨 있다가 일주일에 한 번쯤 가장 낮은 썰물이 오는 날에만 열리는데, 오늘이 그날이라 아침이랑 밤에 몇 시간씩 열렸다가 닫히고, 닫히면 섬에 있는 사람은 못 나오고 이쪽 사람은 못 건너가.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "742a97d7-f445-4440-93c2-39e2fa8a917f",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 17,
  "speaker_type": "PLAYER",
  "role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
  "line_html": "하나만 더 부탁드려도 되겠습니까. 이 지도에는 해안선뿐이라, 섬 쪽에서 물이 어디로 흐르는지 알면 움직이기 편할 것 같습니다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "c7c0db09-c4a4-487f-bbaf-aefee1e7f5c2",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 18,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": null,
  "line_html": "노인은 대꾸 없이 지도를 받아 들더니, 선착장 말뚝에 대고 굵은 파란 펜을 꺼낸다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "6d92a984-0a5f-4785-81ec-e5e11485c956",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 19,
  "speaker_type": "NPC",
  "role_id": null,
  "npc_id": "23b07013-b397-4346-b4cd-97a901836ed5",
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-fisherman\">어부</span>",
  "line_html": "(그리며) 동쪽에서 물이 이렇게 들어와. 섬 북쪽으로 쭉 밀려오다가 이 만에서 힘이 빠져. 빠져나가질 못하고 맴을 돌지. 큰 물은 바깥으로 빠지고.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "ad4aa790-ab8b-40a1-82bb-4350a948b326",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 20,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": null,
  "line_html": "노인이 파란 펜을 귀에 꽂고 붉은 펜으로 바꿔 쥔다. 펜 끝이 섬 북쪽 후미를 따라 두 번, 세 번 동그라미를 그린다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "a870ee83-c7cf-44b5-9418-67ae0a83b2a6",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 21,
  "speaker_type": "NPC",
  "role_id": null,
  "npc_id": "23b07013-b397-4346-b4cd-97a901836ed5",
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-fisherman\">어부</span>",
  "line_html": "여기는 물이 깊고 물살이 이상해서 절대 들어가면 안 돼, 헤엄 잘 치는 사람도 한번 빠지면 못 나오고, 이십 년 전에도 통발 걷으러 건너간 사람이 이 근처 물에 휩쓸려서 끝내 못 찾았으니까.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "56d1944f-892b-418a-a7f0-9ff67d10eaef",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 22,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": null,
  "line_html": "베일라의 손이 지도 가장자리에서 멈춘다. 그녀는 아무 말도 하지 않는다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "ff8ad5e5-cbaa-4b13-bcf7-c0e12ee75577",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 23,
  "speaker_type": "NPC",
  "role_id": null,
  "npc_id": "23b07013-b397-4346-b4cd-97a901836ed5",
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-fisherman\">어부</span>",
  "line_html": "지난 열린 날에는 섬 사람이 한 명도 안 건너왔어. 늘 그날 맞춰서 장 보러 나오던 양반들인데.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "cefb5ab4-d6cf-48ed-af77-49b96534226c",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 24,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": null,
  "line_html": "노인이 지도를 돌려준다. 해안선과 섬 위로 거칠게 겹친 파란 화살표, 섬 북쪽 후미에는 붉은 동그라미가 있다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "6be8a999-4d10-48e2-b914-3cba7982d90e",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 25,
  "speaker_type": "PLAYER",
  "role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
  "line_html": "감사합니다. 큰 도움이 됩니다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "2a8824bd-13c0-4597-acd0-1b306b598ec0",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 26,
  "speaker_type": "NPC",
  "role_id": null,
  "npc_id": "23b07013-b397-4346-b4cd-97a901836ed5",
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-fisherman\">어부</span>",
  "line_html": "밤에 한 번 더 열리니까, 돌아올 때는 그때 오고.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "18e6b82f-6373-4918-ab3a-8feded196009",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 27,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": null,
  "line_html": "노인은 다시 그물로 돌아간다. 선착장 너머로 안개가 얇아지고, 바다가 천천히 뒤로 물러난다. 젖은 자갈과 모래가 길처럼 드러나기 시작한다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "d92aa8ce-6f98-42d6-8cb6-59d0d97934ae",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 28,
  "speaker_type": "PLAYER",
  "role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
  "line_html": "(지도를 접으며) …마커스, 섬부터 보게 해 줘요.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "f7a11d75-8f13-439e-a4bc-f9b5eb29a1a2",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 29,
  "speaker_type": "PLAYER",
  "role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
  "line_html": "(돌아보며) 아까 어부의 이야기에서 손이 멈추셨던데요. 무슨 일입니까?",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "6ecde5c0-11f6-4172-8512-54910bf52123",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 30,
  "speaker_type": "PLAYER",
  "role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
  "line_html": "별일 아니에요. 어릴 때 가 본 곳이라 제가 보면 더 빨리 알아볼 수 있고요. 지난번에 섬 사람이 한 명도 안 건너왔다잖아요. 시설 보고가 끊긴 때와 겹쳐요.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "3783e858-5c93-4f4e-bee5-5a3a4199d462",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 31,
  "speaker_type": "PLAYER",
  "role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
  "line_html": "…제 임무는 시설입니다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "983cc99c-9b35-4e2d-8f74-00c06310ab03",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 32,
  "speaker_type": "PLAYER",
  "role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
  "line_html": "알아요. 마을 입구까지만이라도요. 알아볼 것도 있고요.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "ffae9aee-ab99-4bda-a4e2-fa5d4933b4d6",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 33,
  "speaker_type": "PLAYER",
  "role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
  "line_html": "(한숨을 쉬며) …열려 있는 동안만입니다. 마을 쪽을 확인하고, 저는 시설로 돌아가겠습니다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "630c922f-f4fb-4384-abc2-1b44ec31d517",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 34,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": null,
  "line_html": "두 사람이 바닷길로 들어선다. 자갈이 젖어 발소리를 삼키고, 양쪽으로 낮은 물이 천천히 숨을 쉰다. 뒤에서 선착장의 불빛이 점점 작아진다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "daf46ad0-d427-4953-a367-3d0f1b6148ac",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 35,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": null,
  "line_html": "바닷길의 끝이 가까워졌다. 젖은 모래가 발밑에서 질척거리고, 안개 사이로 섬의 낮은 비탈이 윤곽을 드러낸다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "f6c14773-9cfa-4fac-840d-450d1a45d8b6",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 36,
  "speaker_type": "PLAYER",
  "role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
  "line_html": "저기가 마을이군요. 생각보다 조용합니다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "480bf95e-0e99-4db8-a311-f5c706317008",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 37,
  "speaker_type": "PLAYER",
  "role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
  "line_html": "어릴 때도 이렇게 조용한 섬이었어요. 물때에 맞춰 들어갔다가 나오던 곳이라서요.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "63b2d72c-0e73-415a-89e7-abb78426bc7e",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 38,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": null,
  "line_html": "그때 마을 쪽 비탈에서 한 여자가 내려왔다. 걸음이 급하고, 숨이 조금 차 보인다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "7e317882-b5c7-420b-ae80-06eb089a938e",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 39,
  "speaker_type": "PLAYER",
  "role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
  "line_html": "(걸음을 멈추며) 사람이 있군요.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "0e9fb2ce-c9e1-43d0-91b6-66f1f18b8152",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 40,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": null,
  "line_html": "베일라의 걸음도 멈췄다. 그녀는 숨을 삼키고, 한동안 그 여자에게서 눈을 떼지 못했다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "17b5e902-285c-4c4a-a75f-b2c5632c6ef3",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 41,
  "speaker_type": "PLAYER",
  "role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
  "line_html": "...어슐라?",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "45d26712-1420-4d19-afa6-15d3d785e86c",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 42,
  "speaker_type": "NPC",
  "role_id": null,
  "npc_id": "e435921c-af56-4c30-86b1-57bc21f71e15",
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-ursula\">어슐라</span>",
  "line_html": "(걸음을 늦추고, 잠깐 숨을 고르며) 베일라. 진짜 너네. 이런 데서 다 만나다니.",
  "audio_url": "https://res.cloudinary.com/dkzctfx9z/video/upload/v1791877460/murdex/images/7169e13b-5160-4a9b-9769-8ffd19763aa7/audio/c6047a2e-222c-4f0e-b031-f639619888c0/file_imp2mj.wav",
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-13 16:45:47"
 },
 {
  "line_id": "7e9ade45-ce1a-4d86-bfb5-ce3b6e226fff",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 43,
  "speaker_type": "PLAYER",
  "role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
  "line_html": "지금 어디서 오는 길이야? 그동안 어디 있었어, 연락도 없이. 여긴 왜 온 거야?",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "a8e7bba4-d76a-4330-bac3-462a50249191",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 44,
  "speaker_type": "NPC",
  "role_id": null,
  "npc_id": "e435921c-af56-4c30-86b1-57bc21f71e15",
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-ursula\">어슐라</span>",
  "line_html": "근처에 일이 있어서 왔어. 길게 설명할 시간은 없고. ...연락 못 한 건 미안해.",
  "audio_url": "https://res.cloudinary.com/dkzctfx9z/video/upload/v1791877469/murdex/images/7169e13b-5160-4a9b-9769-8ffd19763aa7/audio/c6047a2e-222c-4f0e-b031-f639619888c0/file_emjfcf.wav",
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-13 16:45:47"
 },
 {
  "line_id": "b39861c0-9341-4a85-99c7-6e47803360d8",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 45,
  "speaker_type": "PLAYER",
  "role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
  "line_html": "(마커스를 돌아보며) 아, 마커스. 제 사촌 어슐라예요. 어릴 때부터 같이 자랐어요. 어슐라, 이쪽은 마커스. 같이 일하고 있어.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "bba79c26-b812-4370-b2e8-37977a20485e",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 46,
  "speaker_type": "PLAYER",
  "role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
  "line_html": "(한 걸음 앞으로 나서며) 마커스라고 합니다. FBI 소속이고, 저쪽 연구시설 일로 이 지역에 왔습니다. 혹시 이 섬에서 연구시설 사람들을 보신 적 있습니까?",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "c46fbf71-21a7-4805-8fc2-65e002aa0476",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 47,
  "speaker_type": "NPC",
  "role_id": null,
  "npc_id": "e435921c-af56-4c30-86b1-57bc21f71e15",
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-ursula\">어슐라</span>",
  "line_html": "(잠깐 베일라 쪽을 보았다가) 연구시설이요? 그쪽 일로 저도 섬을 둘러봤는데, 특별한 건 없었어요. 지금은 돌아가는 길이고요.",
  "audio_url": "https://res.cloudinary.com/dkzctfx9z/video/upload/v1791877472/murdex/images/7169e13b-5160-4a9b-9769-8ffd19763aa7/audio/c6047a2e-222c-4f0e-b031-f639619888c0/file_uusgl7.wav",
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-13 16:45:47"
 },
 {
  "line_id": "fb766fc8-f013-4a35-ba4a-2044ca837d13",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 48,
  "speaker_type": "PLAYER",
  "role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
  "line_html": "돌아간다고? 마을이 이렇게 조용한데, 정말 아무것도 못 봤다는 거야?",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "a6e2c1f6-3adc-4dd5-8f13-5204d89a8337",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 49,
  "speaker_type": "NPC",
  "role_id": null,
  "npc_id": "e435921c-af56-4c30-86b1-57bc21f71e15",
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-ursula\">어슐라</span>",
  "line_html": "마을은... 가 보는 게 좋을지 모르겠어, 베일라.",
  "audio_url": "https://res.cloudinary.com/dkzctfx9z/video/upload/v1791877475/murdex/images/7169e13b-5160-4a9b-9769-8ffd19763aa7/audio/c6047a2e-222c-4f0e-b031-f639619888c0/file_ofxmk4.wav",
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-13 16:45:47"
 },
 {
  "line_id": "7cf73692-8892-46d6-a5f0-f33e7f85af69",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 50,
  "speaker_type": "PLAYER",
  "role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
  "line_html": "그럼 나랑 같이 가. 오랜만에 만났는데 이대로 보낼 수는 없잖아.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "48ab53d7-0a67-40ee-b417-683582410448",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 51,
  "speaker_type": "NPC",
  "role_id": null,
  "npc_id": "e435921c-af56-4c30-86b1-57bc21f71e15",
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-ursula\">어슐라</span>",
  "line_html": "(한참 망설이다가) ...알았어. 대신 오래 있지는 않을 거야.",
  "audio_url": "https://res.cloudinary.com/dkzctfx9z/video/upload/v1791877478/murdex/images/7169e13b-5160-4a9b-9769-8ffd19763aa7/audio/c6047a2e-222c-4f0e-b031-f639619888c0/file_gqxwwg.wav",
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-13 16:45:47"
 },
 {
  "line_id": "6ac1c842-c1c2-4a9b-be14-d3c34cc7bf82",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 52,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": null,
  "line_html": "서쪽 만 쪽 바닷길에는 아직 모래톱이 길게 드러나 있다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "9cd98626-3206-4e0b-885a-026df2962999",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 53,
  "speaker_type": "PLAYER",
  "role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
  "line_html": "저는 시설을 확인하러 가겠습니다. 두 시간마다 알아낸 걸 공유하는 걸로 하죠.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "e93e73ab-4b2f-45d1-9bed-c10cf164f775",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 54,
  "speaker_type": "PLAYER",
  "role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
  "line_html": "알겠어요. 저는 마을부터 돌아볼게요. 조심해요.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "f1557c1d-2af1-45fa-a049-6b17d94eafa7",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 55,
  "speaker_type": "PLAYER",
  "role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
  "line_html": "그쪽도요. (어슐라를 보며) 베일라를 부탁합니다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "8b3528be-bbc5-4058-a648-d3bfbb2fa428",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 56,
  "speaker_type": "NPC",
  "role_id": null,
  "npc_id": "e435921c-af56-4c30-86b1-57bc21f71e15",
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": "<span class=\"character-ursula\">어슐라</span>",
  "line_html": "(잠시 말이 없다가, 희미하게 웃으며) ...걱정 마세요. 이 애는 제가 지킬게요.",
  "audio_url": "https://res.cloudinary.com/dkzctfx9z/video/upload/v1791877481/murdex/images/7169e13b-5160-4a9b-9769-8ffd19763aa7/audio/c6047a2e-222c-4f0e-b031-f639619888c0/file_tagxug.wav",
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-13 16:45:47"
 },
 {
  "line_id": "2087393f-8d21-476b-844c-f777e91344d3",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 57,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "960f9e80-1fce-42f0-aa79-aa413466c32b",
  "speaker_label_html": null,
  "line_html": "마커스는 바닷길 쪽으로 돌아섰다. 안개 속으로 그의 뒷모습이 천천히 멀어졌다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 },
 {
  "line_id": "b8ae6a73-6685-45fd-a661-825ec5405d35",
  "step_id": "9a995366-20d6-47af-9d3e-d7786a503750",
  "line_order": 58,
  "speaker_type": "DIRECTIVE",
  "role_id": null,
  "npc_id": null,
  "owner_role_id": "feda1c8d-9aaa-4a26-aad5-1f37f5715625",
  "speaker_label_html": null,
  "line_html": "비탈 위쪽의 마을에는 불빛도 인기척도 없었다. 어디선가 갈매기 울음이 한 번 들렸다가 멀어졌다. 베일라와 어슐라는 말없이 비탈 앞에 섰다.",
  "audio_url": null,
  "created_at": "2026-10-07 23:37:07",
  "updated_at": "2026-10-07 23:37:07"
 }
]