 },
 {
  "secret_id": "81af348d-3e5e-5701-ba3c-169d83923519",
  "role_id": "2b6fb73c-1dfa-5389-a8c5-e32a64d73bea",
  "secret_title": "동생의 일",
  "secret_content": "<div class=\"story-content\">\n  <p>점주는 여동생 <span class=\"character-seojieun\">서지은</span>에게 자기와 만나 달라고 강요해 왔다. 동생이 거절하자, 토요일까지 마음을 바꾸지 않으면 당신을 횡령으로 고발하겠다고 했다. 알려지면 당신이 점주를 죽이고 싶을 만큼 미워했다는 것이 드러난다.</p>\n</div>",
  "importance_level": "MEDIUM",
  "disclosure_timing": "NEVER",
  "disclosure_step_id": null,
  "disclosure_condition": null,
  "can_share": 1,
  "share_restriction": "FULL",
  "secret_order": 3,
  "created_at": "2026-11-18 20:26:58",
  "updated_at": "2026-11-18 20:26:58"
 },
 {
  "secret_id": "f66222ec-d365-5d4b-9715-afd72a04e662",
  "role_id": "e0a5bcef-3aca-5040-9d68-8d8f1c7a1f22",
  "secret_title": "빼돌린 담배",
  "secret_content": "<div class=\"story-content\">\n  <p>4월부터 납품처 몇 곳에서 담배를 덜 내리고 전표는 원래대로 적었다. 5월에 들킨 뒤로 늘푸른마트에서는 빼지 않았지만, 다른 곳에서는 지금도 빼돌린다. 들키면 회사에서 잘리고 횡령으로 고소당한다.</p>\n</div>",
  "importance_level": "MEDIUM",
  "disclosure_timing": "NEVER",
