 },
 {
  "secret_id": "835b8b64-16c6-531c-a5d4-be8a536a2a4a",
  "role_id": "2b6fb73c-1dfa-5389-a8c5-e32a64d73bea",
  "secret_title": "하드디스크",
  "secret_content": "<div class=\"story-content\">\n  <p>사흘 전 녹화기에서 하드디스크를 빼 가방에 숨겼다. 돈통에서 돈을 꺼내는 장면을 지우려던 것이다. 들키면 사건 전에 CCTV부터 꺼 둔 사람으로 의심받는다.</p>\n</div>",
  "importance_level": "MEDIUM",
  "disclosure_timing": "NEVER",
  "disclosure_step_id": null,
  "disclosure_condition": null,
  "can_share": 1,
  "share_restriction": "FULL",
  "secret_order": 1,
  "created_at": "2026-11-18 20:26:58",
