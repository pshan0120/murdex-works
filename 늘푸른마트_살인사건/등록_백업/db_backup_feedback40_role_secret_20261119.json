 },
 {
  "secret_id": "e5663d12-6f0d-53de-8f43-729899d5d22b",
  "role_id": "2b6fb73c-1dfa-5389-a8c5-e32a64d73bea",
  "secret_title": "어젯밤의 메시지",
  "secret_content": "<div class=\"story-content\">\n  <p>동생에게 \"걱정 마. 사장 일은 내가 끝낼게.\"라고 보냈다. 담판을 짓겠다는 뜻이었지만, 지금 보면 누구라도 다르게 읽을 것이다. 휴대폰은 카운터 아래에 두었다.</p>\n</div>",
  "importance_level": "MEDIUM",
  "disclosure_timing": "NEVER",
  "disclosure_step_id": null,
  "disclosure_condition": null,
  "can_share": 1,
  "share_restriction": "FULL",
