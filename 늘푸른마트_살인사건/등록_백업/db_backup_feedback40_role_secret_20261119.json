 },
 {
  "secret_id": "77944127-d1ff-5ffe-9f37-85ead37445e9",
  "role_id": "ca1fa496-3b0d-507a-a71f-908025b176fb",
  "secret_title": "주머니 속 메모",
  "secret_content": "<div class=\"story-content\">\n  <p>카디건 주머니에 \"화·금 2시 납품. 끝나면 혼자 창고 청소.\"라고 적은 메모지가 있다. 점주와 단둘이 이야기하려고 적어 둔 것이지만, 들키면 점주가 혼자 있을 때를 노렸다는 의심을 받는다.</p>\n</div>",
  "importance_level": "MEDIUM",
  "disclosure_timing": "NEVER",
  "disclosure_step_id": null,
  "disclosure_condition": null,
  "can_share": 1,
  "share_restriction": "FULL",
  "secret_order": 4,
  "created_at": "2026-11-18 20:26:58",
