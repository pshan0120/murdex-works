 },
 {
  "secret_id": "c0c794cb-f3b7-54b8-a7cb-45957e5c94aa",
  "role_id": "ca1fa496-3b0d-507a-a71f-908025b176fb",
  "secret_title": "점주가 있는 곳",
  "secret_content": "<div class=\"story-content\">\n  <p>2시 25분쯤 커피를 사며 알바생에게 점주가 아직 창고에 있는지 물었다. 창고에 있다는 말을 듣고 찾아갈지 망설였다. 알바생이 이 일을 말하면 점주가 혼자 있을 때를 노렸다는 의심을 받는다.</p>\n</div>",
  "importance_level": "MEDIUM",
  "disclosure_timing": "NEVER",
  "disclosure_step_id": null,
  "disclosure_condition": null,
  "can_share": 1,
  "share_restriction": "FULL",
  "secret_order": 5,
  "created_at": "2026-11-18 20:26:58",
  "updated_at": "2026-11-18 23:44:06"
 },
 {
  "secret_id": "7291bf47-34df-55f7-bd14-522b6a4fd138",
  "role_id": "ca1fa496-3b0d-507a-a71f-908025b176fb",
  "secret_title": "지난주의 말",
  "secret_content": "<div class=\"story-content\">\n  <p>사무실 앞에서 점주에게 \"가만두지 않을 거예요\"라고 소리쳤다.</p>\n</div>",
