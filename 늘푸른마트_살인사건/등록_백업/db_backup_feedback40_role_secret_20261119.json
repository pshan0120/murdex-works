 {
  "secret_id": "2c4878b4-64b9-55ae-b0a7-cc1c8b887c61",
  "role_id": "e0a5bcef-3aca-5040-9d68-8d8f1c7a1f22",
  "secret_title": "매달 100만 원",
  "secret_content": "<div class=\"story-content\">\n  <p>5월부터 점주에게 입막음 값으로 매달 100만 원을 보냈다. 점주 통장에 기록이 남아 있을 것이다.</p>\n</div>",
  "importance_level": "MEDIUM",
  "disclosure_timing": "NEVER",
  "disclosure_step_id": null,
  "disclosure_condition": null,
  "can_share": 1,
