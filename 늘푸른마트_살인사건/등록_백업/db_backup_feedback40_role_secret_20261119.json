 },
 {
  "secret_id": "1ad07a6b-1507-573a-8f78-bcda1588d936",
  "role_id": "e0a5bcef-3aca-5040-9d68-8d8f1c7a1f22",
  "secret_title": "2시 16분의 전화",
  "secret_content": "<div class=\"story-content\">\n  <p>점주가 2천만 원을 내일 아침까지 가져오지 않으면 경찰서에 가겠다고 했다. 당신 휴대폰 통화 목록에도 1분 12초짜리 통화가 남아 있다.</p>\n</div>",
  "importance_level": "MEDIUM",
  "disclosure_timing": "NEVER",
  "disclosure_step_id": null,
  "disclosure_condition": null,
  "can_share": 1,
