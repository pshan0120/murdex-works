            "clueOrder": 8,
            "clueSource": "OBJECTIVE_FACT",
            "variants": [
                {
                    "clueName": "유황 냄새가 배인 양피지",
                    "clueContent": "<div class='clue-detail'><p>위자드 집무실 책장 뒤쪽에 숨겨져 있던 <span class='mystery'>검붉은 양피지</span>입니다. 지옥의 고대 문자로 작성되어 있으며, 강렬한 유황 냄새가 납니다. 양피지 아래에 <span class='highlight'>차원 좌표로 보이는 복잡한 수식</span>이 적혀 있습니다.</p></div>",
                    "variantType": "DEFAULT",
