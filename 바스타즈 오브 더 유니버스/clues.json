            "clueType": "OBSERVATION",
            "importanceLevel": "HIGH",
            "apCost": 2,
            "clueOrder": 14,
            "clueSource": "OBJECTIVE_FACT",
            "variants": [
                {
                    "clueName": "연구실 천장의 긁힌 자국",
                    "clueContent": "<div class='clue-detail'><p>위자드 연구실 천장의 환기구 격자에 <span class='emphasis'>가느다란 무언가가 걸려 있던 마찰 흔적</span>이 있습니다. 격자 한쪽에 <span class='highlight'>보라색 섬유 올 한 가닥</span>이 끼어 있으며, 환기구 내부에서 아래쪽(위자드의 의자 방향)으로 무언가를 매달았던 것처럼 <span class='emphasis'>미세한 홈</span>이 파여 있습니다.</p></div>",
                    "variantType": "DEFAULT",
                    "isDefault": true,
                    "priority": 100
                }
            ]
        },
