[
  {
    "lineOrder": 0,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "speakerLabelHtml": null,
    "lineHtml": "모든 증거는 거구의 수인 <span class=\"character-gorehoof\">고어후프</span>가 이성을 잃고 <span class=\"character-eldritch\">엘드리치</span>를 살해했음을 가리키고 있었다.",
    "audioUrl": null
  },
  {
    "lineOrder": 1,
    "speakerType": "PLAYER",
    "roleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "npcId": null,
    "ownerRoleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "speakerLabelHtml": "<span class=\"character-elantra\">엘란트라</span>",
    "lineHtml": "식당 뼈에 남은 이빨 자국, 당신 것이더군요. 이성을 잃으면 무슨 짓을 할지 예측할 수 없는 사람입니다.",
    "audioUrl": null
  },
  {
    "lineOrder": 2,
    "speakerType": "PLAYER",
    "roleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "npcId": null,
    "ownerRoleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "speakerLabelHtml": "<span class=\"character-balrog\">발로그</span>",
    "lineHtml": "협박까지 당하고 있었다지. 죽일 이유는 충분하다.",
    "audioUrl": null
  },
  {
    "lineOrder": 3,
    "speakerType": "PLAYER",
    "roleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "npcId": null,
    "ownerRoleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "speakerLabelHtml": "<span class=\"character-slither\">슬리더</span>",
    "lineHtml": "칼도 있었고, 동기도 있었다. 더 볼 것도 없군.",
    "audioUrl": null
  },
  {
    "lineOrder": 4,
    "speakerType": "PLAYER",
    "roleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "npcId": null,
    "ownerRoleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "speakerLabelHtml": "<span class=\"character-skullcrusher\">스컬크러셔</span>",
    "lineHtml": "명예를 지킨다더니, 결국 짐승처럼 굴었나.",
    "audioUrl": null
  },
  {
    "lineOrder": 5,
    "speakerType": "PLAYER",
    "roleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "npcId": null,
    "ownerRoleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "speakerLabelHtml": "<span class=\"character-malice\">말리스</span>",
    "lineHtml": "정황은 다 갖춰졌네요.",
    "audioUrl": null
  },
  {
    "lineOrder": 6,
    "speakerType": "PLAYER",
    "roleId": "eb5d2bcb-b7ea-4747-b523-c39ff330d7bb",
    "npcId": null,
    "ownerRoleId": "eb5d2bcb-b7ea-4747-b523-c39ff330d7bb",
    "speakerLabelHtml": "<span class=\"character-gorehoof\">고어후프</span>",
    "lineHtml": "칼을 들고 나선 건 인정한다. 하지만 그 방에 닿기도 전에 발길을 돌렸어! 나는 손끝 하나 대지 않았다!",
    "audioUrl": null
  },
  {
    "lineOrder": 7,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "speakerLabelHtml": null,
    "lineHtml": "아무도 그 말을 믿어주지 않았다. 처형이 결정되었다.",
    "audioUrl": null
  },
  {
    "lineOrder": 8,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "speakerLabelHtml": null,
    "lineHtml": "<span class=\"character-balrog\">발로그</span>가 공중에서 짓눌러 움직임을 묶었다. <span class=\"character-elantra\">엘란트라</span>의 장창이 무릎 뒤를 끊어 무너뜨렸다. <span class=\"character-slither\">슬리더</span>의 단검이 힘줄을 끊었다.",
    "audioUrl": null
  },
  {
    "lineOrder": 9,
    "speakerType": "PLAYER",
    "roleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "npcId": null,
    "ownerRoleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "speakerLabelHtml": "<span class=\"character-malice\">말리스</span>",
    "lineHtml": "지금이에요.",
    "audioUrl": null
  },
  {
    "lineOrder": 10,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "speakerLabelHtml": null,
    "lineHtml": "<span class=\"character-skullcrusher\">스컬크러셔</span>의 대검이 마무리를 지었다.",
    "audioUrl": null
  },
  {
    "lineOrder": 11,
    "speakerType": "PLAYER",
    "roleId": "eb5d2bcb-b7ea-4747-b523-c39ff330d7bb",
    "npcId": null,
    "ownerRoleId": "eb5d2bcb-b7ea-4747-b523-c39ff330d7bb",
    "speakerLabelHtml": "<span class=\"character-gorehoof\">고어후프</span>",
    "lineHtml": "...전하지 못한 게, 딱 하나 있었는데.",
    "audioUrl": null
  },
  {
    "lineOrder": 12,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "speakerLabelHtml": null,
    "lineHtml": "<span class=\"character-gorehoof\">고어후프</span>가 무너졌다. 품속에서 붉은 목걸이 하나가 굴러떨어졌다. <span class=\"character-malice\">말리스</span>는 그것을 잠시 내려다보았을 뿐, 이내 시선을 돌렸다.",
    "audioUrl": null
  },
  {
    "lineOrder": 13,
    "speakerType": "PLAYER",
    "roleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "npcId": null,
    "ownerRoleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "speakerLabelHtml": "<span class=\"character-elantra\">엘란트라</span>",
    "lineHtml": "더 볼 것도 없다는 말, 동의합니다.",
    "audioUrl": null
  },
  {
    "lineOrder": 14,
    "speakerType": "PLAYER",
    "roleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "npcId": null,
    "ownerRoleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "speakerLabelHtml": "<span class=\"character-balrog\">발로그</span>",
    "lineHtml": "...예상한 결과다.",
    "audioUrl": null
  },
  {
    "lineOrder": 15,
    "speakerType": "PLAYER",
    "roleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "npcId": null,
    "ownerRoleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "speakerLabelHtml": "<span class=\"character-slither\">슬리더</span>",
    "lineHtml": "...조용하다.",
    "audioUrl": null
  },
  {
    "lineOrder": 16,
    "speakerType": "PLAYER",
    "roleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "npcId": null,
    "ownerRoleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "speakerLabelHtml": "<span class=\"character-skullcrusher\">스컬크러셔</span>",
    "lineHtml": "...명예는, 끝내 지키지 못했군.",
    "audioUrl": null
  },
  {
    "lineOrder": 17,
    "speakerType": "PLAYER",
    "roleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "npcId": null,
    "ownerRoleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "speakerLabelHtml": "<span class=\"character-malice\">말리스</span>",
    "lineHtml": "치정 문제였을지도 모르겠네요.",
    "audioUrl": null
  },
  {
    "lineOrder": 18,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "eb5d2bcb-b7ea-4747-b523-c39ff330d7bb",
    "speakerLabelHtml": null,
    "lineHtml": "잠깐의 시간이 흘렀다.",
    "audioUrl": null
  },
  {
    "lineOrder": 19,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "4dd4a9f1-5254-4bd1-b4ee-195e13526ba9",
    "speakerLabelHtml": null,
    "lineHtml": "성채 곳곳에서 <span class=\"emphasis\">영혼석</span>이 빛나기 시작했다. 어두운 기운이 <span class=\"character-gorehoof\">고어후프</span>의 시신으로 스며들었다.",
    "audioUrl": null
  },
  {
    "lineOrder": 20,
    "speakerType": "PLAYER",
    "roleId": "4dd4a9f1-5254-4bd1-b4ee-195e13526ba9",
    "npcId": null,
    "ownerRoleId": "4dd4a9f1-5254-4bd1-b4ee-195e13526ba9",
    "speakerLabelHtml": "<span class=\"mystery\">다크 시리어스(엘드리치)</span>",
    "lineHtml": "이 압도적인 완력이라니. <span class=\"character-gorehoof\">고어후프</span>, 네 광기가 나를 파괴의 화신으로 완성시켰다.",
    "audioUrl": null
  },
  {
    "lineOrder": 21,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "speakerLabelHtml": null,
    "lineHtml": "시신을 매개로 마신 <span class=\"mystery\">다크 시리어스</span>가 일어섰다. 하지만 새 육신에 완전히 적응하지 못한 틈이 있었다.",
    "audioUrl": null
  },
  {
    "lineOrder": 22,
    "speakerType": "PLAYER",
    "roleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "npcId": null,
    "ownerRoleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "speakerLabelHtml": "<span class=\"character-malice\">말리스</span>",
    "lineHtml": "아직 힘을 다루지 못해요! 돌진만 흘려내면 관절이 빕니다!",
    "audioUrl": null
  },
  {
    "lineOrder": 23,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "speakerLabelHtml": null,
    "lineHtml": "<span class=\"character-elantra\">엘란트라</span>의 방패가 돌진의 궤도를 틀었다. 마신은 그대로 벽에 처박혔다.",
    "audioUrl": null
  },
  {
    "lineOrder": 24,
    "speakerType": "PLAYER",
    "roleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "npcId": null,
    "ownerRoleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "speakerLabelHtml": "<span class=\"character-elantra\">엘란트라</span>",
    "lineHtml": "돌진, 흘려냈습니다!",
    "audioUrl": null
  },
  {
    "lineOrder": 25,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "speakerLabelHtml": null,
    "lineHtml": "비틀거리는 다리를 <span class=\"character-slither\">슬리더</span>의 단검이 끊었다.",
    "audioUrl": null
  },
  {
    "lineOrder": 26,
    "speakerType": "PLAYER",
    "roleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "npcId": null,
    "ownerRoleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "speakerLabelHtml": "<span class=\"character-slither\">슬리더</span>",
    "lineHtml": "관절은... 내가 끊는다.",
    "audioUrl": null
  },
  {
    "lineOrder": 27,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "speakerLabelHtml": null,
    "lineHtml": "무너진 틈으로 <span class=\"character-skullcrusher\">스컬크러셔</span>의 대검이 가슴팍을 갈랐다.",
    "audioUrl": null
  },
  {
    "lineOrder": 28,
    "speakerType": "PLAYER",
    "roleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "npcId": null,
    "ownerRoleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "speakerLabelHtml": "<span class=\"character-skullcrusher\">스컬크러셔</span>",
    "lineHtml": "이걸로 끝이다!",
    "audioUrl": null
  },
  {
    "lineOrder": 29,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "speakerLabelHtml": null,
    "lineHtml": "마지막으로 <span class=\"character-balrog\">발로그</span>가 위에서 마무리를 지었다.",
    "audioUrl": null
  },
  {
    "lineOrder": 30,
    "speakerType": "PLAYER",
    "roleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "npcId": null,
    "ownerRoleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "speakerLabelHtml": "<span class=\"character-balrog\">발로그</span>",
    "lineHtml": "위에서, 마무리한다.",
    "audioUrl": null
  },
  {
    "lineOrder": 31,
    "speakerType": "PLAYER",
    "roleId": "4dd4a9f1-5254-4bd1-b4ee-195e13526ba9",
    "npcId": null,
    "ownerRoleId": "4dd4a9f1-5254-4bd1-b4ee-195e13526ba9",
    "speakerLabelHtml": "<span class=\"mystery\">다크 시리어스(엘드리치)</span>",
    "lineHtml": "이 압도적인 힘을 쥐고도... 고작 이 정도에게.",
    "audioUrl": null
  },
  {
    "lineOrder": 32,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "eb5d2bcb-b7ea-4747-b523-c39ff330d7bb",
    "speakerLabelHtml": null,
    "lineHtml": "포효와 함께 마신의 육신이 잿더미로 허물어졌다.",
    "audioUrl": null
  },
  {
    "lineOrder": 33,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "4dd4a9f1-5254-4bd1-b4ee-195e13526ba9",
    "speakerLabelHtml": null,
    "lineHtml": "거친 숨을 몰아쉬는 생존자들 사이로 정적이 감돌았다.",
    "audioUrl": null
  },
  {
    "lineOrder": 34,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "speakerLabelHtml": null,
    "lineHtml": "아무도 몰랐다. <span class=\"character-gorehoof\">고어후프</span>가 죽는 순간까지 결백했다는 것을. 승리를 만끽하는 <span class=\"character-malice\">말리스</span>와 <span class=\"character-balrog\">발로그</span>조차 몰랐다. 그들이 놓은 덫이 아니라, <span class=\"character-eldritch\">엘드리치</span> 자신이 그것을 발동시켜 스스로 죽음을 완성했다는 사실을.",
    "audioUrl": null
  },
  {
    "lineOrder": 35,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "speakerLabelHtml": null,
    "lineHtml": "공식적인 수장은 여전히 <span class=\"character-skullcrusher\">스컬크러셔</span>였다. 하지만 마신과의 사투 내내 명령을 내린 것은 <span class=\"character-malice\">말리스</span>였고, 살아남은 이들은 이미 그녀의 목소리를 따르는 데 익숙해져 있었다. 굳이 선언할 필요도 없이, 실권은 자연스럽게 그녀에게로 넘어갔다. <span class=\"character-balrog\">발로그</span>는 그녀의 곁을 지키는 그림자가 되었다. 수평적이던 <span class=\"character-bastards\">바스타즈</span>는 겉모습은 그대로인 채, 안으로는 그녀를 정점으로 한 수직의 질서로 재편되었다.",
    "audioUrl": null
  }
]