[
  {
    "lineOrder": 0,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "speakerLabelHtml": null,
    "lineHtml": "모든 증거는 거구의 수인 <span class=\"character-gorehoof\">고어후프</span>가 이성을 잃고 <span class=\"character-eldritch\">엘드리치</span>를 살해했음을 가리키고 있었다.",
    "audioUrl": null
  },
  {
    "lineOrder": 1,
    "speakerType": "PLAYER",
    "roleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "npcId": null,
    "ownerRoleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "speakerLabelHtml": "<span class=\"character-elantra\">엘란트라</span>",
    "lineHtml": "식당 뼈에 남은 이빨 자국, 당신 것이더군요. 이성을 잃으면 무슨 짓을 할지 예측할 수 없는 사람입니다.",
    "audioUrl": null
  },
  {
    "lineOrder": 2,
    "speakerType": "PLAYER",
    "roleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "npcId": null,
    "ownerRoleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "speakerLabelHtml": "<span class=\"character-balrog\">발로그</span>",
    "lineHtml": "협박까지 당하고 있었다지. 죽일 이유는 충분하다.",
    "audioUrl": null
  },
  {
    "lineOrder": 3,
    "speakerType": "PLAYER",
    "roleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "npcId": null,
    "ownerRoleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "speakerLabelHtml": "<span class=\"character-slither\">슬리더</span>",
    "lineHtml": "칼도 있었고, 동기도 있었다. 더 볼 것도 없군.",
    "audioUrl": null
  },
  {
    "lineOrder": 4,
    "speakerType": "PLAYER",
    "roleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "npcId": null,
    "ownerRoleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "speakerLabelHtml": "<span class=\"character-skullcrusher\">스컬크러셔</span>",
    "lineHtml": "명예를 지킨다더니, 결국 짐승처럼 굴었나.",
    "audioUrl": null
  },
  {
    "lineOrder": 5,
    "speakerType": "PLAYER",
    "roleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "npcId": null,
    "ownerRoleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "speakerLabelHtml": "<span class=\"character-malice\">말리스</span>",
    "lineHtml": "정황은 다 갖춰졌네요.",
    "audioUrl": null
  },
  {
    "lineOrder": 6,
    "speakerType": "PLAYER",
    "roleId": "eb5d2bcb-b7ea-4747-b523-c39ff330d7bb",
    "npcId": null,
    "ownerRoleId": "eb5d2bcb-b7ea-4747-b523-c39ff330d7bb",
    "speakerLabelHtml": "<span class=\"character-gorehoof\">고어후프</span>",
    "lineHtml": "칼을 들고 나선 건 인정한다. 하지만 그 방에 닿기도 전에 발길을 돌렸어! 나는 손끝 하나 대지 않았다!",
    "audioUrl": null
  },
  {
    "lineOrder": 7,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "speakerLabelHtml": null,
    "lineHtml": "아무도 그 말을 믿어주지 않았다. 처형이 결정되었다.",
    "audioUrl": null
  },
  {
    "lineOrder": 8,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "speakerLabelHtml": null,
    "lineHtml": "<span class=\"character-balrog\">발로그</span>가 공중에서 짓눌러 움직임을 묶었다. <span class=\"character-elantra\">엘란트라</span>의 장창이 무릎 뒤를 끊어 무너뜨렸다. <span class=\"character-slither\">슬리더</span>의 단검이 힘줄을 끊었다.",
    "audioUrl": null
  },
  {
    "lineOrder": 9,
    "speakerType": "PLAYER",
    "roleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "npcId": null,
    "ownerRoleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "speakerLabelHtml": "<span class=\"character-malice\">말리스</span>",
    "lineHtml": "지금이에요.",
    "audioUrl": null
  },
  {
    "lineOrder": 10,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "speakerLabelHtml": null,
    "lineHtml": "<span class=\"character-skullcrusher\">스컬크러셔</span>의 대검이 마무리를 지었다.",
    "audioUrl": null
  },
  {
    "lineOrder": 11,
    "speakerType": "PLAYER",
    "roleId": "eb5d2bcb-b7ea-4747-b523-c39ff330d7bb",
    "npcId": null,
    "ownerRoleId": "eb5d2bcb-b7ea-4747-b523-c39ff330d7bb",
    "speakerLabelHtml": "<span class=\"character-gorehoof\">고어후프</span>",
    "lineHtml": "...전하지 못한 게, 딱 하나 있었는데.",
    "audioUrl": null
  },
  {
    "lineOrder": 12,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "speakerLabelHtml": null,
    "lineHtml": "<span class=\"character-gorehoof\">고어후프</span>가 무너졌다. 품속에서 붉은 목걸이 하나가 굴러떨어졌다. <span class=\"character-malice\">말리스</span>는 그것을 잠시 내려다보았을 뿐, 이내 시선을 돌렸다.",
    "audioUrl": null
  },
  {
    "lineOrder": 13,
    "speakerType": "PLAYER",
    "roleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "npcId": null,
    "ownerRoleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "speakerLabelHtml": "<span class=\"character-elantra\">엘란트라</span>",
    "lineHtml": "더 볼 것도 없다는 말, 동의합니다.",
    "audioUrl": null
  },
  {
    "lineOrder": 14,
    "speakerType": "PLAYER",
    "roleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "npcId": null,
    "ownerRoleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "speakerLabelHtml": "<span class=\"character-balrog\">발로그</span>",
    "lineHtml": "...예상한 결과다.",
    "audioUrl": null
  },
  {
    "lineOrder": 15,
    "speakerType": "PLAYER",
    "roleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "npcId": null,
    "ownerRoleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "speakerLabelHtml": "<span class=\"character-slither\">슬리더</span>",
    "lineHtml": "...조용하다.",
    "audioUrl": null
  },
  {
    "lineOrder": 16,
    "speakerType": "PLAYER",
    "roleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "npcId": null,
    "ownerRoleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "speakerLabelHtml": "<span class=\"character-skullcrusher\">스컬크러셔</span>",
    "lineHtml": "...명예는, 끝내 지키지 못했군.",
    "audioUrl": null
  },
  {
    "lineOrder": 17,
    "speakerType": "PLAYER",
    "roleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "npcId": null,
    "ownerRoleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "speakerLabelHtml": "<span class=\"character-malice\">말리스</span>",
    "lineHtml": "치정 문제였을지도 모르겠네요.",
    "audioUrl": null
  },
  {
    "lineOrder": 18,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "eb5d2bcb-b7ea-4747-b523-c39ff330d7bb",
    "speakerLabelHtml": null,
    "lineHtml": "잠깐의 시간이 흘렀다.",
    "audioUrl": null
  },
  {
    "lineOrder": 19,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "4dd4a9f1-5254-4bd1-b4ee-195e13526ba9",
    "speakerLabelHtml": null,
    "lineHtml": "성채 곳곳에서 <span class=\"emphasis\">영혼석</span>이 빛나기 시작했다. 어두운 기운이 <span class=\"character-gorehoof\">고어후프</span>의 시신으로 스며들었다.",
    "audioUrl": null
  },
  {
    "lineOrder": 20,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "speakerLabelHtml": null,
    "lineHtml": "시신에 <span class=\"character-eldritch\">엘드리치</span>의 영혼이 깃들었다. 짓밟힌 육신이 일어섰다. 본모습, 마신 <span class=\"mystery\">다크 시리어스</span>였다.",
    "audioUrl": null
  },
  {
    "lineOrder": 21,
    "speakerType": "PLAYER",
    "roleId": "4dd4a9f1-5254-4bd1-b4ee-195e13526ba9",
    "npcId": null,
    "ownerRoleId": "4dd4a9f1-5254-4bd1-b4ee-195e13526ba9",
    "speakerLabelHtml": "<span class=\"mystery\">다크 시리어스(엘드리치)</span>",
    "lineHtml": "이 짐승 같은 완력이라니. <span class=\"character-gorehoof\">고어후프</span>, 네 광기가 나를 완성했다.",
    "audioUrl": null
  },
  {
    "lineOrder": 22,
    "speakerType": "PLAYER",
    "roleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "npcId": null,
    "ownerRoleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "speakerLabelHtml": "<span class=\"character-skullcrusher\">스컬크러셔</span>",
    "lineHtml": "...스승님? 설마, 이 짐승 같은 힘이 당신 것이었습니까...",
    "audioUrl": null
  },
  {
    "lineOrder": 23,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "speakerLabelHtml": null,
    "lineHtml": "짧은 침묵 끝에, 그는 부러진 대검을 고쳐 쥐고 소리쳤다.",
    "audioUrl": null
  },
  {
    "lineOrder": 24,
    "speakerType": "PLAYER",
    "roleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "npcId": null,
    "ownerRoleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "speakerLabelHtml": "<span class=\"character-skullcrusher\">스컬크러셔</span>",
    "lineHtml": "전원 흩어져서 틈을 노려라!",
    "audioUrl": null
  },
  {
    "lineOrder": 25,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "speakerLabelHtml": null,
    "lineHtml": "<span class=\"character-malice\">말리스</span>가 대형을 지시하려 했지만 소용없었다. 손짓 한 번에 그녀가 나가떨어졌다.",
    "audioUrl": null
  },
  {
    "lineOrder": 26,
    "speakerType": "PLAYER",
    "roleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "npcId": null,
    "ownerRoleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "speakerLabelHtml": "<span class=\"character-malice\">말리스</span>",
    "lineHtml": "전술로는... 상대가 안 됩니다.",
    "audioUrl": null
  },
  {
    "lineOrder": 27,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "speakerLabelHtml": null,
    "lineHtml": "<span class=\"character-elantra\">엘란트라</span>의 방패가 정면을 막아섰지만, 방패째로 튕겨나갔다.",
    "audioUrl": null
  },
  {
    "lineOrder": 28,
    "speakerType": "PLAYER",
    "roleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "npcId": null,
    "ownerRoleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "speakerLabelHtml": "<span class=\"character-elantra\">엘란트라</span>",
    "lineHtml": "...방패로는, 버틸 수 없는 힘이군요.",
    "audioUrl": null
  },
  {
    "lineOrder": 29,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "d7951888-0d3d-465b-8b98-b0d0ba71ec45",
    "speakerLabelHtml": null,
    "lineHtml": "<span class=\"character-slither\">슬리더</span>가 몸을 날렸지만, 그대로 붙잡혀 짓눌렸다.",
    "audioUrl": null
  },
  {
    "lineOrder": 30,
    "speakerType": "PLAYER",
    "roleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "npcId": null,
    "ownerRoleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "speakerLabelHtml": "<span class=\"character-slither\">슬리더</span>",
    "lineHtml": "...잡혔다.",
    "audioUrl": null
  },
  {
    "lineOrder": 31,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "eb5d2bcb-b7ea-4747-b523-c39ff330d7bb",
    "speakerLabelHtml": null,
    "lineHtml": "<span class=\"character-balrog\">발로그</span>가 공중에서 강습했지만, 그대로 붙잡혀 바닥에 처박혔다.",
    "audioUrl": null
  },
  {
    "lineOrder": 32,
    "speakerType": "PLAYER",
    "roleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "npcId": null,
    "ownerRoleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "speakerLabelHtml": "<span class=\"character-balrog\">발로그</span>",
    "lineHtml": "...공중에도, 도피처는 없다.",
    "audioUrl": null
  },
  {
    "lineOrder": 33,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "4dd4a9f1-5254-4bd1-b4ee-195e13526ba9",
    "speakerLabelHtml": null,
    "lineHtml": "홀로 남은 <span class=\"character-skullcrusher\">스컬크러셔</span>가 부러진 대검을 들었다.",
    "audioUrl": null
  },
  {
    "lineOrder": 34,
    "speakerType": "PLAYER",
    "roleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "npcId": null,
    "ownerRoleId": "2f2a7aa6-325f-45af-8df5-ab59f77befe8",
    "speakerLabelHtml": "<span class=\"character-skullcrusher\">스컬크러셔</span>",
    "lineHtml": "...스승님, 당신이 지켰어야 할 명예가 이겁니까.",
    "audioUrl": null
  },
  {
    "lineOrder": 35,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "51600663-84e1-48aa-90c4-165216877f6f",
    "speakerLabelHtml": null,
    "lineHtml": "<span class=\"character-skullcrusher\">스컬크러셔</span>마저 쓰러지며, 마신의 승리가 확정되었다.",
    "audioUrl": null
  },
  {
    "lineOrder": 36,
    "speakerType": "PLAYER",
    "roleId": "4dd4a9f1-5254-4bd1-b4ee-195e13526ba9",
    "npcId": null,
    "ownerRoleId": "4dd4a9f1-5254-4bd1-b4ee-195e13526ba9",
    "speakerLabelHtml": "<span class=\"mystery\">다크 시리어스(엘드리치)</span>",
    "lineHtml": "다섯이 와도 벌레처럼 짓밟힐 뿐이었다. 이 우주도 곧, 내 발밑에서 짓눌릴 것이다.",
    "audioUrl": null
  },
  {
    "lineOrder": 37,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "a2ebd181-3f7c-4aed-86f1-21b0a2c200aa",
    "speakerLabelHtml": null,
    "lineHtml": "아무도 몰랐다. <span class=\"character-gorehoof\">고어후프</span>가 죽는 순간까지 결백했다는 것을. <span class=\"character-malice\">말리스</span>와 <span class=\"character-balrog\">발로그</span>가 짠 살인 계획도, 실은 끝내 완성되지 못했다. <span class=\"character-eldritch\">엘드리치</span>는 그들의 트랩을 스스로 작동시켜 자기 죽음을 완성했을 뿐이었다. 하지만 이제 그 사실을 아는 이조차 남지 않았다.",
    "audioUrl": null
  },
  {
    "lineOrder": 38,
    "speakerType": "DIRECTIVE",
    "roleId": null,
    "npcId": null,
    "ownerRoleId": "aea60f9f-c9b9-4bd9-9d75-fd88c8909066",
    "speakerLabelHtml": null,
    "lineHtml": "야성도 이성도 소용없는 밤이었다. 바스타즈의 시대는 그렇게 저물었다.",
    "audioUrl": null
  }
]