      "npc_id": "2bc9c26e-9c7e-11f1-9efd-00163eeec7f2",
      "story_id": "16fe248f-fac7-4272-8385-544f02b13b02",
      "name": "소장",
      "npc_order": 2
    },
    {
      "npc_id": "b7d6161e-b811-42d0-bbca-33e9a08e6d68",
      "story_id": "16fe248f-fac7-4272-8385-544f02b13b02",
      "name": "클레이",
      "npc_order": 1
    }
  ],
  "step_example": [
    {
      "line_id": "12617413-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 0,
      "speaker_type": "PLAYER",
      "role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "npc_id": null,
      "owner_role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "speaker_label_html": "<span class=\"character-lee\">이준서</span>",
      "line_html": "세린아, 어떻게 된 거야?"
    },
    {
      "line_id": "126177bf-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 1,
      "speaker_type": "PLAYER",
      "role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "npc_id": null,
      "owner_role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "speaker_label_html": "<span class=\"character-han\">한세린</span>",
      "line_html": "와줘서 고마워. 근데 진짜 큰일이야. 발표자 노트가 2페이지부터 다 사라졌어."
    },
    {
      "line_id": "1261793e-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 2,
      "speaker_type": "PLAYER",
      "role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "npc_id": null,
      "owner_role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "speaker_label_html": "<span class=\"character-lee\">이준서</span>",
      "line_html": "일단 침착하자. 혹시 자동 복구 파일 같은 거 안 남아 있을까?"
    },
    {
      "line_id": "12617a9a-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 3,
      "speaker_type": "PLAYER",
      "role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "npc_id": null,
      "owner_role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "speaker_label_html": "<span class=\"character-han\">한세린</span>",
      "line_html": "봤는데 없어. 완전 깔끔하게 사라졌어."
    },
    {
      "line_id": "12617c8d-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 4,
      "speaker_type": "PLAYER",
      "role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "npc_id": null,
      "owner_role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "speaker_label_html": "<span class=\"character-lee\">이준서</span>",
      "line_html": "그럼 지금부터라도 다시 쓰면 돼. 밤새면 가능해."
    },
    {
      "line_id": "12617dd0-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 5,
      "speaker_type": "PLAYER",
      "role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "npc_id": null,
      "owner_role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "speaker_label_html": "<span class=\"character-han\">한세린</span>",
      "line_html": "밤새서? 이게 하루 이틀 준비한 것도 아니잖아."
    },
    {
      "line_id": "12617f98-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 6,
      "speaker_type": "PLAYER",
      "role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "npc_id": null,
      "owner_role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "speaker_label_html": "<span class=\"character-lee\">이준서</span>",
      "line_html": "그래도 방법은 그거뿐이야. 발표는 내일이고."
    },
    {
      "line_id": "126180e5-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 7,
      "speaker_type": "PLAYER",
      "role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "npc_id": null,
      "owner_role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "speaker_label_html": "<span class=\"character-han\">한세린</span>",
      "line_html": "근데... 이거 누가 일부러 그런 거면 어떡해?"
    },
    {
      "line_id": "1261821d-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 8,
      "speaker_type": "PLAYER",
      "role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "npc_id": null,
      "owner_role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "speaker_label_html": "<span class=\"character-lee\">이준서</span>",
      "line_html": "일부러?"
    },
    {
      "line_id": "12618351-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 9,
      "speaker_type": "PLAYER",
      "role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "npc_id": null,
      "owner_role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "speaker_label_html": "<span class=\"character-han\">한세린</span>",
      "line_html": "응. 다른 발표 조도 이 컴퓨터 쓰잖아."
    },
    {
      "line_id": "12618719-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 10,
      "speaker_type": "PLAYER",
      "role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "npc_id": null,
      "owner_role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "speaker_label_html": "<span class=\"character-lee\">이준서</span>",
      "line_html": "...굳이 그럴 이유가 있을까?"
    },
    {
      "line_id": "12618866-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 11,
      "speaker_type": "PLAYER",
      "role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "npc_id": null,
      "owner_role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "speaker_label_html": "<span class=\"character-han\">한세린</span>",
      "line_html": "경쟁 심하면 별일 다 하잖아. 그냥 넘어갈 일은 아닌 것 같아."
    },
    {
      "line_id": "12619918-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 12,
      "speaker_type": "PLAYER",
      "role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "npc_id": null,
      "owner_role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "speaker_label_html": "<span class=\"character-lee\">이준서</span>",
      "line_html": "지금 중요한 건 복구야. 범인 찾는 건 나중 문제고."
    },
    {
      "line_id": "12619ad8-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 13,
      "speaker_type": "PLAYER",
      "role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "npc_id": null,
      "owner_role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "speaker_label_html": "<span class=\"character-han\">한세린</span>",
      "line_html": "난 반대야. 지금 잡아야지. 아니면 또 무슨 짓 할지 몰라."
    },
    {
      "line_id": "12619c18-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 14,
      "speaker_type": "DIRECTIVE",
      "role_id": null,
      "npc_id": null,
      "owner_role_id": "5e4c365f-84cc-4350-9468-a47712f960c9",
      "speaker_label_html": null,
      "line_html": "(<span class=\"character-choi\">최도윤</span> 등장)"
    },
    {
      "line_id": "12619d48-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 15,
      "speaker_type": "PLAYER",
      "role_id": "5e4c365f-84cc-4350-9468-a47712f960c9",
      "npc_id": null,
      "owner_role_id": "5e4c365f-84cc-4350-9468-a47712f960c9",
      "speaker_label_html": "<span class=\"character-choi\">최도윤</span>",
      "line_html": "어... 선배님들?"
    },
    {
      "line_id": "1261a5b2-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 16,
      "speaker_type": "PLAYER",
      "role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "npc_id": null,
      "owner_role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "speaker_label_html": "<span class=\"character-lee\">이준서</span>",
      "line_html": "<span class=\"character-choi\">도윤</span> 씨, 왔어요?"
    },
    {
      "line_id": "1261a740-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 17,
      "speaker_type": "PLAYER",
      "role_id": "5e4c365f-84cc-4350-9468-a47712f960c9",
      "npc_id": null,
      "owner_role_id": "5e4c365f-84cc-4350-9468-a47712f960c9",
      "speaker_label_html": "<span class=\"character-choi\">최도윤</span>",
      "line_html": "네. 집에 가다가 단톡 보고 돌아왔어요. 무슨 일인가 해서..."
    },
    {
      "line_id": "1261b6c5-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 18,
      "speaker_type": "PLAYER",
      "role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "npc_id": null,
      "owner_role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "speaker_label_html": "<span class=\"character-han\">한세린</span>",
      "line_html": "발표자 노트가 날라갔어."
    },
    {
      "line_id": "1261b8a1-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 19,
      "speaker_type": "PLAYER",
      "role_id": "5e4c365f-84cc-4350-9468-a47712f960c9",
      "npc_id": null,
      "owner_role_id": "5e4c365f-84cc-4350-9468-a47712f960c9",
      "speaker_label_html": "<span class=\"character-choi\">최도윤</span>",
      "line_html": "...네? 발표자 노트만요?"
    },
    {
      "line_id": "1261b9eb-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 20,
      "speaker_type": "PLAYER",
      "role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "npc_id": null,
      "owner_role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "speaker_label_html": "<span class=\"character-lee\">이준서</span>",
      "line_html": "슬라이드는 괜찮은데 노트만 없어졌어요."
    },
    {
      "line_id": "1261bb35-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 21,
      "speaker_type": "PLAYER",
      "role_id": "5e4c365f-84cc-4350-9468-a47712f960c9",
      "npc_id": null,
      "owner_role_id": "5e4c365f-84cc-4350-9468-a47712f960c9",
      "speaker_label_html": "<span class=\"character-choi\">최도윤</span>",
      "line_html": "그럼... 발표는 가능한 거죠?"
    },
    {
      "line_id": "1261bc64-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 22,
      "speaker_type": "PLAYER",
      "role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "npc_id": null,
      "owner_role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "speaker_label_html": "<span class=\"character-han\">한세린</span>",
      "line_html": "지금부터 다시 해도 될까말까야."
    },
    {
      "line_id": "1261bdad-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 23,
      "speaker_type": "PLAYER",
      "role_id": "5e4c365f-84cc-4350-9468-a47712f960c9",
      "npc_id": null,
      "owner_role_id": "5e4c365f-84cc-4350-9468-a47712f960c9",
      "speaker_label_html": "<span class=\"character-choi\">최도윤</span>",
      "line_html": "...이거 큰일이네요."
    },
    {
      "line_id": "1261bee2-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 24,
      "speaker_type": "PLAYER",
      "role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "npc_id": null,
      "owner_role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "speaker_label_html": "<span class=\"character-lee\">이준서</span>",
      "line_html": "그래서 지금부터라도 다시 만들자고 얘기 중이에요."
    },
    {
      "line_id": "1261c0f0-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 25,
      "speaker_type": "DIRECTIVE",
      "role_id": null,
      "npc_id": null,
      "owner_role_id": "829bb351-5616-4443-b589-6802bcfc353e",
      "speaker_label_html": null,
      "line_html": "(<span class=\"character-hwang\">황기순</span> 등장)"
    },
    {
      "line_id": "1261c201-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 26,
      "speaker_type": "PLAYER",
      "role_id": "829bb351-5616-4443-b589-6802bcfc353e",
      "npc_id": null,
      "owner_role_id": "829bb351-5616-4443-b589-6802bcfc353e",
      "speaker_label_html": "<span class=\"character-hwang\">황기순</span>",
      "line_html": "다들 와 있었구나."
    },
    {
      "line_id": "1261c31b-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 27,
      "speaker_type": "PLAYER",
      "role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "npc_id": null,
      "owner_role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "speaker_label_html": "<span class=\"character-lee\">이준서</span>",
      "line_html": "선배님, 오셨어요."
    },
    {
      "line_id": "1261c448-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 28,
      "speaker_type": "PLAYER",
      "role_id": "829bb351-5616-4443-b589-6802bcfc353e",
      "npc_id": null,
      "owner_role_id": "829bb351-5616-4443-b589-6802bcfc353e",
      "speaker_label_html": "<span class=\"character-hwang\">황기순</span>",
      "line_html": "단톡 보자마자 왔어. 무슨 일이니?"
    },
    {
      "line_id": "1261c568-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 29,
      "speaker_type": "PLAYER",
      "role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "npc_id": null,
      "owner_role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "speaker_label_html": "<span class=\"character-han\">한세린</span>",
      "line_html": "발표자 노트가 없어졌어요."
    },
    {
      "line_id": "1261c7c3-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 30,
      "speaker_type": "PLAYER",
      "role_id": "829bb351-5616-4443-b589-6802bcfc353e",
      "npc_id": null,
      "owner_role_id": "829bb351-5616-4443-b589-6802bcfc353e",
      "speaker_label_html": "<span class=\"character-hwang\">황기순</span>",
      "line_html": "...아. 그래?"
    },
    {
      "line_id": "1261c919-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 31,
      "speaker_type": "PLAYER",
      "role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "npc_id": null,
      "owner_role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "speaker_label_html": "<span class=\"character-lee\">이준서</span>",
      "line_html": "혹시 선배님, 백업 같은 거..."
    },
    {
      "line_id": "1261ca4f-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 32,
      "speaker_type": "PLAYER",
      "role_id": "829bb351-5616-4443-b589-6802bcfc353e",
      "npc_id": null,
      "owner_role_id": "829bb351-5616-4443-b589-6802bcfc353e",
      "speaker_label_html": "<span class=\"character-hwang\">황기순</span>",
      "line_html": "나는 없어. 근데 이상하긴 하네. 노트만 딱 지워졌다는 게."
    },
    {
      "line_id": "1261db17-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 33,
      "speaker_type": "PLAYER",
      "role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "npc_id": null,
      "owner_role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "speaker_label_html": "<span class=\"character-han\">한세린</span>",
      "line_html": "그것만 골라서 지운 게 이상해요."
    },
    {
      "line_id": "1261dccf-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 34,
      "speaker_type": "PLAYER",
      "role_id": "5e4c365f-84cc-4350-9468-a47712f960c9",
      "npc_id": null,
      "owner_role_id": "5e4c365f-84cc-4350-9468-a47712f960c9",
      "speaker_label_html": "<span class=\"character-choi\">최도윤</span>",
      "line_html": "그러게요. 왜 그런 걸까요?"
    },
    {
      "line_id": "1261dea4-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 35,
      "speaker_type": "PLAYER",
      "role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "npc_id": null,
      "owner_role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "speaker_label_html": "<span class=\"character-lee\">이준서</span>",
      "line_html": "어쨌든 내일 발표하려면 지금부터 바로 다시 써야 해요."
    },
    {
      "line_id": "1261dffc-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 36,
      "speaker_type": "PLAYER",
      "role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "npc_id": null,
      "owner_role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "speaker_label_html": "<span class=\"character-han\">한세린</span>",
      "line_html": "...난 솔직히 그냥 넘어가고 싶진 않아요. 누가 했든, 이유는 알아야겠어요."
    },
    {
      "line_id": "1261e275-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 37,
      "speaker_type": "PLAYER",
      "role_id": "829bb351-5616-4443-b589-6802bcfc353e",
      "npc_id": null,
      "owner_role_id": "829bb351-5616-4443-b589-6802bcfc353e",
      "speaker_label_html": "<span class=\"character-hwang\">황기순</span>",
      "line_html": "동의해. 오늘 이 근처에 누가 있었는지만이라도 각자 조금씩 알아보자."
    },
    {
      "line_id": "1261e3d7-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 38,
      "speaker_type": "PLAYER",
      "role_id": "5e4c365f-84cc-4350-9468-a47712f960c9",
      "npc_id": null,
      "owner_role_id": "5e4c365f-84cc-4350-9468-a47712f960c9",
      "speaker_label_html": "<span class=\"character-choi\">최도윤</span>",
      "line_html": "그게 좋을 것 같아요. 크게 벌리지는 말고요."
    },
    {
      "line_id": "1261e506-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 39,
      "speaker_type": "PLAYER",
      "role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "npc_id": null,
      "owner_role_id": "c9189b82-8c13-4801-8ded-27b6677dab21",
      "speaker_label_html": "<span class=\"character-lee\">이준서</span>",
      "line_html": "그렇다면 알겠어요. 시간이 많이 없으니 30분 후에 여기서 다시 모여요."
    },
    {
      "line_id": "1261f3b8-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 40,
      "speaker_type": "PLAYER",
      "role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "npc_id": null,
      "owner_role_id": "87923507-de3c-4bbd-933a-ed2e7ca39002",
      "speaker_label_html": "<span class=\"character-han\">한세린</span>",
      "line_html": "그럼 흩어져서 찾아봐요."
    },
    {
      "line_id": "1261f566-97ba-11f1-9efd-00163eeec7f2",
      "step_id": "2d2b56e4-14f7-42d7-9576-7bca9a5d5f39",
      "line_order": 41,
      "speaker_type": "PLAYER",
      "role_id": "829bb351-5616-4443-b589-6802bcfc353e",
      "npc_id": null,
      "owner_role_id": "829bb351-5616-4443-b589-6802bcfc353e",
      "speaker_label_html": "<span class=\"character-hwang\">황기순</span>",
      "line_html": "그래. 뭐라도 나와야 할 텐데..."
    }
  ],
  "ending_example": [
    {
      "line_id": "53557bb6-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 0,
      "speaker_type": "DIRECTIVE",
      "role_id": null,
      "npc_id": null,
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": null,
      "line_html": "더 이상 대화로는 답이 나오지 않는다고 판단한 순간, 마커스의 손이 먼저 움직였다. 베일라가 무언가를 하기도 전에, 그는 훈련된 손놀림으로 그녀의 양팔을 등 뒤로 꺾어 제압했다."
    },
    {
      "line_id": "53557fca-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 1,
      "speaker_type": "PLAYER",
      "role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "npc_id": null,
      "owner_role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
      "line_html": "미안해요. 하지만 이건 내가 끝내야 할 문제야."
    },
    {
      "line_id": "5355816c-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 2,
      "speaker_type": "DIRECTIVE",
      "role_id": null,
      "npc_id": null,
      "owner_role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "speaker_label_html": null,
      "line_html": "베일라는 비명을 질렀다."
    },
    {
      "line_id": "5355829c-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 3,
      "speaker_type": "PLAYER",
      "role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "npc_id": null,
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
      "line_html": "마커스, 제발! 이러지 말아요!"
    },
    {
      "line_id": "535595a5-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 4,
      "speaker_type": "DIRECTIVE",
      "role_id": null,
      "npc_id": null,
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": null,
      "line_html": "그는 대답 대신 그녀를 붙든 손에 힘을 더할 뿐이었다. 그녀는 몸부림쳤지만 마커스의 완력을 벗어날 수 없었다. 그는 자신을 붙든 채 절규하는 그녀를 뒤로하고, 뒷걸음질 치는 소장에게 다가섰다. 마커스에게 저 얼굴은 더 이상 은인의 얼굴이 아니었다. 과거 살의의 폭주로 누나를 죽게 만들고, 이제는 진짜 클레이 소장마저 살해하고 소장 행세를 하는 괴물일 뿐이었다."
    },
    {
      "line_id": "53559725-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 5,
      "speaker_type": "DIRECTIVE",
      "role_id": null,
      "npc_id": null,
      "owner_role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "speaker_label_html": null,
      "line_html": "궁지에 몰린 소장은 두 손을 들어 올리며 뒷걸음질 쳤다."
    },
    {
      "line_id": "53559834-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 6,
      "speaker_type": "NPC",
      "role_id": null,
      "npc_id": "2bc9c26e-9c7e-11f1-9efd-00163eeec7f2",
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": null,
      "line_html": "잠깐, 제 말 좀 들어보십시오. 저는... 제가 무슨 짓을 했는지도 정확히 기억나지 않습니다. 눈을 떴을 때는 이미 다 벌어진 뒤였어요. 저도 제가 무섭습니다. 그러니 제발..."
    },
    {
      "line_id": "5355997a-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 7,
      "speaker_type": "DIRECTIVE",
      "role_id": null,
      "npc_id": null,
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": null,
      "line_html": "마커스는 걸음을 멈추지 않았다."
    },
    {
      "line_id": "53559a7d-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 8,
      "speaker_type": "PLAYER",
      "role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "npc_id": null,
      "owner_role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
      "line_html": "그 말, 이해는 합니다. 하지만 저는 이미 그런 사고로 누나를 잃었습니다. 다음엔 또 누구를 잃게 될지, 더는 기다려줄 수 없습니다."
    },
    {
      "line_id": "53559bb8-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 9,
      "speaker_type": "DIRECTIVE",
      "role_id": null,
      "npc_id": null,
      "owner_role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "speaker_label_html": null,
      "line_html": "좁은 배양실에 마지막 총성이 울려 퍼졌다."
    },
    {
      "line_id": "5355aab1-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 10,
      "speaker_type": "DIRECTIVE",
      "role_id": null,
      "npc_id": null,
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": null,
      "line_html": "사건 발생 일주일 후, 정부의 특수 조사반이 현장 감식 결과를 통보했다. 마커스가 쏘아 죽인 자의 시체에서는 뇌 기저부에 심어진 제어 칩이 발견되었고, 기록 보관실 시체는 진짜 클레이 소장으로 최종 확인되었다. 마커스의 판단은 정확했다. 하지만 그 정확함이 그에게 안식을 주지는 않았다."
    },
    {
      "line_id": "5355ad67-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 11,
      "speaker_type": "DIRECTIVE",
      "role_id": null,
      "npc_id": null,
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": null,
      "line_html": "압수된 연구 자료는 국가 기밀로 봉인되었다. 하지만 그보다 더 무겁게 그를 짓누른 것은, 그날 이후 단 한 번도 자신을 쳐다보지 않는 베일라의 눈빛이었다."
    },
    {
      "line_id": "5355ae97-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 12,
      "speaker_type": "DIRECTIVE",
      "role_id": null,
      "npc_id": null,
      "owner_role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "speaker_label_html": null,
      "line_html": "베일라는 정부 조사반의 보고서를 통해 뒤늦게 진실을 확인했다. 자신이 지키려 했던 그 소장은 정말로 자신의 연인, 클레이의 유전자로 만들어진 복제 인간 <span class=\"character-alex\">알렉스</span>가 맞았다. 마커스의 판단이 사건의 진상과는 일치했을지언정, 그것은 동시에 그녀에게서 연인을 영원히 앗아간 판단이기도 했다. 그녀는 자신의 팔을 짓누르던 그 완력의 감촉을 오래도록 잊지 못했다. 옳았던 선택과, 용서할 수 없는 방식. 두 가지는 결코 하나로 합쳐지지 않았다."
    },
    {
      "line_id": "5355afb3-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 13,
      "speaker_type": "DIRECTIVE",
      "role_id": null,
      "npc_id": null,
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": null,
      "line_html": "사건으로부터 한 달이 지난 어느 오후, 베일라의 휴대폰에 낯선 번호로 문자 한 통이 도착했다. \"프로메테우스 사건 최종 보고서, 당사자 확인 서명 요청.\" 정부 기록보관소에서 보내온, 지극히 사무적인 한 줄이었다."
    },
    {
      "line_id": "5355b0b8-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 14,
      "speaker_type": "DIRECTIVE",
      "role_id": null,
      "npc_id": null,
      "owner_role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "speaker_label_html": null,
      "line_html": "약속된 시각, 낡은 관공서 회의실 문을 열었을 때 그녀를 기다리고 있던 건 서류 뭉치와 함께 창가에 서 있는 마커스였다. 두 사람은 잠시 말없이 서로를 바라보았다. 그날 이후 처음 마주하는 얼굴이었다."
    },
    {
      "line_id": "5355c294-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 15,
      "speaker_type": "PLAYER",
      "role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "npc_id": null,
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
      "line_html": "와 계실 줄은 몰랐네요."
    },
    {
      "line_id": "5355c451-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 16,
      "speaker_type": "DIRECTIVE",
      "role_id": null,
      "npc_id": null,
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": null,
      "line_html": "마커스는 옅게 고개를 끄덕이며 맞은편 의자를 가리켰다."
    },
    {
      "line_id": "5355c5c9-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 17,
      "speaker_type": "PLAYER",
      "role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "npc_id": null,
      "owner_role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
      "line_html": "뭐라고 적어야 할지 모르겠더군요. 복제 인간이라고 쓰자니 너무 건조하고, 실험체라고 쓰자니... 그건 아닌 것 같아서."
    },
    {
      "line_id": "5355c712-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 18,
      "speaker_type": "PLAYER",
      "role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "npc_id": null,
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
      "line_html": "저도 그 칸 앞에서 한참을 멈춰 있었어요."
    },
    {
      "line_id": "5355c838-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 19,
      "speaker_type": "PLAYER",
      "role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "npc_id": null,
      "owner_role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
      "line_html": "사실 이 손끝 떨림, 유전병입니다. 누나가 그걸 고치려고 모든 걸 걸었죠."
    },
    {
      "line_id": "5355c967-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 20,
      "speaker_type": "PLAYER",
      "role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "npc_id": null,
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
      "line_html": "지금은... 좀 어때요?"
    },
    {
      "line_id": "5355ca85-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 21,
      "speaker_type": "PLAYER",
      "role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "npc_id": null,
      "owner_role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
      "line_html": "많이 나아졌습니다. 시설을 정리하던 정부 집행팀이, 클레이가 죽기 직전까지 매달렸던 연구 기록에서 결국 완성해낸 치료제를 찾아냈다더군요. 그 덕에 지금은 치료받고 있습니다."
    },
    {
      "line_id": "5355d941-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 22,
      "speaker_type": "PLAYER",
      "role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "npc_id": null,
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
      "line_html": "그 사람과 보낸 시간이... 거짓 위에 세워진 거였다 해도, 저한테는 여전히 진짜였어요."
    },
    {
      "line_id": "5355dad2-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 23,
      "speaker_type": "DIRECTIVE",
      "role_id": null,
      "npc_id": null,
      "owner_role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "speaker_label_html": null,
      "line_html": "두 사람 사이에 있었던 일들에 대해서는, 서로 굳이 캐묻지 않았다. 다만 그날 각자가 무엇을 지키려 했는지는, 이제 어렴풋이 알 것 같았다."
    },
    {
      "line_id": "5355dbe8-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 24,
      "speaker_type": "PLAYER",
      "role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "npc_id": null,
      "owner_role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
      "line_html": "그래서, 이 칸에는 뭐라고 적을까요."
    },
    {
      "line_id": "535626df-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 25,
      "speaker_type": "PLAYER",
      "role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "npc_id": null,
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
      "line_html": "사실... 그 사람 정체를 알아내겠다고 온갖 자료를 뒤지던 시절이 있었어요. 그러다 어느 옛날 책에서 이런 단어를 봤죠. 자기와 똑같이 생긴 존재를 마주치면 불길한 일이 생긴다는, 그런 미신에서 나온 말이더라고요. '도플갱어'라고. 그때는 그냥 흥미로운 이야기 정도로만 여겼는데."
    },
    {
      "line_id": "5356288f-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 26,
      "speaker_type": "PLAYER",
      "role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "npc_id": null,
      "owner_role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
      "line_html": "그리고 이쪽은... 사람이 아니라 만들어진 존재죠. 안드로이드처럼."
    },
    {
      "line_id": "535629cc-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 27,
      "speaker_type": "PLAYER",
      "role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "npc_id": null,
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
      "line_html": "맞아요. 도플갱어랑, 안드로이드... 그 중간 어디쯤 아닐까요."
    },
    {
      "line_id": "535638c8-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 28,
      "speaker_type": "PLAYER",
      "role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "npc_id": null,
      "owner_role_id": "eeca3699-93e7-45ff-9591-1c63facc0807",
      "speaker_label_html": "<span class=\"character-marcus\">마커스</span>",
      "line_html": "도플로이드."
    },
    {
      "line_id": "09232ecf-9bc4-4560-af44-301dd2b76c9e",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 29,
      "speaker_type": "PLAYER",
      "role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "npc_id": null,
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": "<span class=\"character-veyla\">베일라</span>",
      "line_html": "...나쁘지 않네요."
    },
    {
      "line_id": "53563a16-9c7e-11f1-9efd-00163eeec7f2",
      "ending_id": "2036746f-dd30-41fc-abfc-488d15929917",
      "line_order": 30,
      "speaker_type": "DIRECTIVE",
      "role_id": null,
      "npc_id": null,
      "owner_role_id": "2f2f9e71-20fe-44c1-a5d8-4e9bbde6a176",
      "speaker_label_html": null,
      "line_html": "두 사람은 그렇게, 세상에 없던 이름 하나를 함께 완성했다. 서류 위에 적힌 그 단어는, 그날 이전에는 어디에도 존재하지 않았던 이름이었다."
    }
  ]
}